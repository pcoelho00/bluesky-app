# Bluesky credentials
BLUESKY_HANDLE=your.handle.bsky.social
BLUESKY_PASSWORD=your_app_password

# Claude AI credentials
ANTHROPIC_API_KEY=your_anthropic_api_key

# Database settings
# DB_ENVIRONMENT controls which database to use:
# - "local" = SQLite database (default)
# - "production" = Turso cloud database
DB_ENVIRONMENT=local

# Local SQLite database settings
DATABASE_PATH=./data/bluesky_feed.db

# Production Turso database settings (only needed when DB_ENVIRONMENT=production)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Application settings
DEFAULT_DAYS_BACK=1
MAX_POSTS_PER_FETCH=100
MAX_PROMPT_CHARS=20000
API_RETRY_ATTEMPTS=3
API_RETRY_BASE_DELAY=0.5
