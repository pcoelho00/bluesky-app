# Bluesky credentials
BLUESKY_HANDLE=your.handle.bsky.social
BLUESKY_PASSWORD=your_app_password

# AI provider credentials
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Database settings
# DATABASE_URL is the primary setting (any SQLAlchemy-compatible URL).
# If not set, DATABASE_PATH is converted to a sqlite:/// URL automatically.
# Examples:
#   sqlite:///./data/bluesky_feed.db
#   postgresql://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///./data/bluesky_feed.db

# Legacy SQLite file path (used when DATABASE_URL is not set)
DATABASE_PATH=./data/bluesky_feed.db

# Application settings
DEFAULT_DAYS_BACK=1
MAX_POSTS_PER_FETCH=100
MAX_PROMPT_CHARS=20000
API_RETRY_ATTEMPTS=3
API_RETRY_BASE_DELAY=0.5
